{
  "name": "teng0ni-mineflayer",
  "version": "4.42.2",
  "description": "create minecraft bots with a stable, high level API",
  "main": "index.js",
  "types": "index.d.ts",
  "scripts": {
    "mocha_test": "mocha --reporter spec --exit",
    "test": "npm run mocha_test",
    "test:integration:26-1": "docker-compose -f test/integration/docker-compose.26-1.yml up -d && node test/integration/wait-for-port.js 25577 && mocha test/integration/26_1/*.test.js --timeout 120000 ; docker-compose -f test/integration/docker-compose.26-1.yml down -v",
    "pretest": "npm run lint",
    "lint": "standard && standard-markdown",
    "fix": "standard --fix && standard-markdown --fix",
    "prepublishOnly": "cp docs/README.md README.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wupengabc/mineflayer.git"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "minecraft-data": "github:TimiSeila/teng0ni-minecraft-data",
    "minecraft-protocol": "github:TimiSeila/teng0ni-minecraft-protocol",
    "mojangson": "^2.1.0",
    "prismarine-biome": "^1.4.0",
    "prismarine-block": "^1.23.0",
    "prismarine-chat": "github:TimiSeila/teng0ni-prismarine-chat",
    "prismarine-chunk": "npm:@wp2508/prismarine-chunk@^1.41.3",
    "prismarine-entity": "^2.6.0",
    "prismarine-item": "^1.18.0",
    "prismarine-nbt": "^2.8.0",
    "prismarine-physics": "npm:@wp2508/prismarine-physics@^1.12.3",
    "prismarine-recipe": "^1.5.0",
    "prismarine-registry": "github:TimiSeila/teng0ni-prismarine-registry",
    "prismarine-windows": "^2.10.0",
    "prismarine-world": "^3.7.0",
    "protodef": "npm:@wp2508/protodef@^1.19.3",
    "socks": "^2.8.10",
    "typed-emitter": "^1.4.0",
    "uuid-1345": "^1.0.2",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "doctoc": "^2.5.0",
    "fast-check": "^4.10.2",
    "minecraft-wrap": "^1.10.0",
    "mineflayer": "./",
    "mocha": "^11.8.0",
    "protodef-yaml": "^1.5.7",
    "standard": "^17.1.2",
    "standard-markdown": "^7.1.0",
    "typescript": "^5.9.3"
  }
}
